# Manifest-covered module payloads are byte-exact.  Do not apply Git's text
# conversion to them on Windows: their SHA-256 values cover the stored bytes.
modules/** -text

# The network registry also pins the original bytes of its Wallet icon assets.
src/holon_wallet/qml/assets/** -text

# Canonical module JSON must retain LF line endings.
src/holon_modules/module-catalog.json text eol=lf
module-manifest.json text eol=lf
